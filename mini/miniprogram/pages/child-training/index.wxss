page { height: 100%; overflow: hidden; background: #eef2f7; }.training-shell { height: 100%; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); }.training-head { min-height: 116rpx; padding: 20rpx 22rpx; display: flex; align-items: center; gap: 18rpx; background: #fff; }.training-head button { flex: none; width: 104rpx; margin: 0; padding: 12rpx 0; color: #536174; font-size: 24rpx; line-height: 1.4; background: #eef1f6; }.training-head>view:nth-child(2) { flex: 1; min-width: 0; }.training-head text { display: block; }.game-name { font-size: 29rpx; font-weight: 800; }.instruction { margin-top: 3rpx; overflow: hidden; color: #68768a; font-size: 20rpx; white-space: nowrap; text-overflow: ellipsis; }.metrics { flex: none; text-align: right; font-size: 22rpx; font-weight: 700; }.metrics text+text { margin-top: 4rpx; color: #657181; font-size: 19rpx; }.progress { height: 7rpx; background: #dce2eb; }.progress view { height: 100%; background: #3158df; transition: width .2s; }.canvas-wrap { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }.child-canvas { width: 92vw; height: 92vw; max-width: 58vh; max-height: 58vh; flex: none; background: #eef2f7; }.feedback { position: absolute; top: 45%; left: 50%; padding: 16rpx 26rpx; transform: translate(-50%,-50%); border-radius: 40rpx; color: #fff; font-size: 30rpx; font-weight: 800; }.feedback.good { background: #15956d; }.feedback.bad { background: #d7495e; }.answer-area { min-height: 170rpx; padding: 18rpx 25rpx 24rpx; text-align: center; color: #536174; font-size: 25rpx; }.direction-pad { width: 300rpx; margin: 0 auto; display: grid; grid-template: repeat(2,70rpx)/repeat(3,90rpx); gap: 8rpx; justify-content: center; }.direction-pad button { margin: 0; padding: 0; line-height: 70rpx; background: #fff; }.direction-pad button:nth-child(1) { grid-column: 2; }.direction-pad button:nth-child(2) { grid-row: 2; grid-column: 1; }.direction-pad button:nth-child(3) { grid-row: 2; grid-column: 3; }.direction-pad button:nth-child(4) { grid-row: 2; grid-column: 2; }.side-pad { display: flex; gap: 24rpx; }.side-pad button { flex: 1; background: #fff; color: #1b2a43; }

.training-head .session-actions { display: flex; gap: 8rpx; } .training-head .session-actions button { width: 82rpx; }

.answer-area .ready-to-tap { color: #d32f2f; }
