page { background: #eef1f5; }
.training-page { min-height: 100vh; padding: 22rpx 22rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.toolbar, .metrics { display: flex; align-items: center; justify-content: space-between; }
.toolbar { color: #3d4960; font-size: 24rpx; }
.status-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #3b67ef; }
.mode { margin-left: 18rpx; color: #111c44; font-weight: 750; }
.exit { margin: 0; padding: 0 20rpx; height: 58rpx; line-height: 58rpx; color: #536078; background: #fff; border-radius: 15rpx; font-size: 23rpx; }
.metrics { margin: 24rpx 0 16rpx; padding: 18rpx 22rpx; background: #fff; border-radius: 20rpx; }
.metrics view { flex: 1; text-align: center; }
.metrics text { display: block; margin-top: 6rpx; font-size: 25rpx; font-weight: 750; }
.metrics .metric-label { margin-top: 0; color: #8791a2; font-size: 20rpx; font-weight: 400; }
.track { height: 7rpx; margin-bottom: 18rpx; overflow: hidden; border-radius: 8rpx; background: #dce1e8; }.track view { height: 100%; background: #3158df; transition: width .25s; }
.stage { position: relative; width: 100%; height: calc(100vw - 44rpx); overflow: hidden; border-radius: 24rpx; background: rgb(158,158,158); box-shadow: 0 14rpx 34rpx rgba(27,37,60,.12); }
.canvas { width: 100%; height: 100%; }
.fixation { position: absolute; left: 50%; top: 50%; width: 26rpx; height: 26rpx; margin: -14rpx; border: 3rpx solid rgba(30,36,48,.8); border-radius: 50%; }
.interval { position: absolute; left: 0; right: 0; top: 24rpx; text-align: center; color: rgba(20,28,42,.65); font-size: 22rpx; }
.feedback { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); font-size: 110rpx; font-weight: 800; }.feedback.good { color: #1d9b67; }.feedback.bad { color: #ce4257; }
.finished { position: absolute; left: 48rpx; right: 48rpx; top: 50%; transform: translateY(-50%); padding: 30rpx; text-align: center; border-radius: 24rpx; background: rgba(255,255,255,.92); }
.finished text { display: block; }.finished .finished-title { font-size: 32rpx; font-weight: 750; }.finished text { margin-top: 12rpx; color: #657181; font-size: 24rpx; }
.response { padding-top: 22rpx; }.prompt { display: block; min-height: 76rpx; text-align: center; white-space: pre-line; color: #536078; font-size: 25rpx; line-height: 1.55; }
.buttons { display: flex; gap: 18rpx; }.buttons button { flex: 1; margin: 0; padding: 18rpx 10rpx; color: #fff; background: #172752; border-radius: 20rpx; line-height: 1.35; }.buttons button[disabled] { color: #8e96a5; background: #d9dde4; }
.buttons text { display: block; margin-top: 5rpx; font-size: 21rpx; opacity: .75; }.buttons .button-key { margin-top: 0; font-size: 27rpx; font-weight: 750; opacity: 1; }
