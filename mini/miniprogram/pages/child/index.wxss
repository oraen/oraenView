.game-list { margin-top: 28rpx; }
.game-card { width: 100%; margin: 16rpx 0; padding: 24rpx; display: flex; align-items: center; text-align: left; }
.game-icon { flex: none; font-weight: 800; width: 78rpx; height: 78rpx; margin-right: 20rpx; border-radius: 22rpx; background: #eef2ff; color: #3158df; font-size: 38rpx; line-height: 78rpx; text-align: center; }
.game-card view { flex: 1; }.game-card text { display: block; }.game-name { font-size: 30rpx; font-weight: 750; }.game-caption { margin-top: 5rpx; color: #657181; font-size: 24rpx; }.game-skill { margin-top: 7rpx; color: #3158df; font-size: 21rpx; }.level-badge { min-width: 64rpx; padding: 8rpx 12rpx; border-radius: 18rpx; color: #3158df; background: #eef2ff; font-size: 22rpx; font-weight: 700; text-align: center; }
.setup-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(10,18,42,.58); }.setup { width: 100%; padding: 36rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; }.setup-title { margin: 10rpx 0; font-size: 38rpx; font-weight: 800; }.setup-copy { color: #657181; font-size: 25rpx; line-height: 1.65; }.field { margin-top: 25rpx; }.field>text { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 700; }.field label { margin-right: 24rpx; font-size: 25rpx; }.confirm { display: block; margin-top: 28rpx; color: #405067; font-size: 24rpx; }.setup-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }.setup-actions button { flex: 1; }.setup-actions .primary { background: #3158df; color: #fff; }

.tutorial { width: 100%; padding: 38rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; text-align: center; } .tutorial-icon { width: 128rpx; height: 128rpx; margin: 28rpx auto 12rpx; border-radius: 34rpx; color: #fff; background: #6c63ff; font-size: 62rpx; line-height: 128rpx; } .tutorial-skill { margin-top: 20rpx; color: #7a8598; font-size: 23rpx; }
