.records-head { display: flex; align-items: center; justify-content: space-between; }
.clear { margin: 0; padding: 0 20rpx; height: 60rpx; line-height: 60rpx; color: #c13e50; background: #fff; border: 1rpx solid #f0cbd1; border-radius: 16rpx; font-size: 23rpx; }
.kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin: 30rpx 0; }.kpis .card { padding: 24rpx; }.kpis text { display: block; color: #677287; font-size: 23rpx; }.kpis .kpi-value { margin: 10rpx 0 2rpx; color: #111c44; font-size: 39rpx; font-weight: 750; }.kpis .kpi-unit { color: #9aa3b1; font-size: 20rpx; }
.panel { margin-top: 22rpx; padding: 28rpx; }.panel>.subtle { margin-top: 8rpx; }
.levels { margin-top: 20rpx; }.level { padding: 20rpx 0; border-top: 1rpx solid #edf0f5; }.level>view { display: flex; justify-content: space-between; }.level text { color: #3158df; font-size: 22rpx; }.level .level-name { color: #111c44; font-size: 26rpx; font-weight: 750; }.level .level-value { display: block; margin-top: 10rpx; color: #111c44; font-size: 28rpx; font-weight: 750; }.level .level-description { color: #8b95a6; font-size: 21rpx; }
.chart { width: 100%; height: 280rpx; margin-top: 18rpx; }
.mode-row { margin-top: 24rpx; }.mode-row>view:first-child { display: flex; justify-content: space-between; font-size: 24rpx; }.mode-row text { color: #7f899a; }.mode-row .mode-name { color: #111c44; font-weight: 750; }.bar { height: 10rpx; margin-top: 12rpx; overflow: hidden; border-radius: 10rpx; background: #e8ecf3; }.bar view { height: 100%; background: #3158df; border-radius: 10rpx; }
.trend { margin-top: 26rpx; }.trend>view { display: flex; justify-content: space-between; font-size: 24rpx; }.trend text { color: #3158df; }.trend .trend-name { color: #111c44; font-weight: 750; }.trend-chart { width: 100%; height: 210rpx; margin-top: 8rpx; }
.history { margin-bottom: 32rpx; }.empty { padding: 60rpx 0 30rpx; text-align: center; color: #99a2b1; font-size: 25rpx; }.session { display: flex; justify-content: space-between; padding: 24rpx 0; border-top: 1rpx solid #edf0f5; }.session:first-of-type { margin-top: 18rpx; }.session>view:last-child { text-align: right; }.session text { display: block; margin-top: 7rpx; color: #8993a5; font-size: 21rpx; }.session .session-name,.session .session-rate { margin-top: 0; color: #111c44; font-size: 25rpx; font-weight: 750; }.session .complete { color: #268361; }.session .incomplete { color: #b16b35; }
.detail-mask { position: fixed; z-index: 20; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: flex-end; background: rgba(10,18,39,.48); }.detail-sheet { width: 100%; max-height: 78vh; padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; box-sizing: border-box; }.detail-head { display: flex; align-items: center; justify-content: space-between; }.detail-head .detail-title { font-size: 27rpx; font-weight: 750; }.detail-head button { margin: 0; padding: 0; width: 58rpx; height: 58rpx; line-height: 55rpx; color: #637086; background: #f0f2f6; border-radius: 50%; }.trial-scroll { height: 62vh; }.trial { padding: 22rpx 0; border-bottom: 1rpx solid #edf0f5; }.trial text { display: block; }.trial .trial-result { float: right; margin-top: -30rpx; font-weight: 750; }.trial .trial-meta { margin-top: 7rpx; color: #7e899a; font-size: 21rpx; }.trial .good { color: #268361; }.trial .bad { color: #c44255; }
